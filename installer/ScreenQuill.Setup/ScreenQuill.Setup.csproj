<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets .NET Framework 4.8, which ships with Windows 10 (1903+) and 11, so Setup.exe is a
       small standalone file that needs no runtime download. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ScreenQuill-Setup</AssemblyName>
    <RootNamespace>ScreenQuill.Setup</RootNamespace>
    <ApplicationIcon>..\..\src\ScreenQuill\Assets\ScreenQuill.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>ScreenQuill Setup</Product>
    <Description>ScreenQuill installer</Description>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="..\..\src\ScreenQuill\Assets\ScreenQuill.ico" LogicalName="ScreenQuill.ico" />
  </ItemGroup>

</Project>
