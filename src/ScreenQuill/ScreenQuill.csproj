<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ScreenQuill.ico</ApplicationIcon>
    <AssemblyName>ScreenQuill</AssemblyName>
    <RootNamespace>ScreenQuill</RootNamespace>
    <Product>ScreenQuill</Product>
    <Description>Always-on-top screen annotation for Windows</Description>
    <Version>1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF reads DPI awareness from app.manifest; the WinForms analyzer hint does not apply. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WM_POINTER based stylus stack: real pressure, per-contact touch ids, no WISP dependency. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Input.Stylus.EnablePointerSupport" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ScreenQuill.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenQuill.Core\ScreenQuill.Core.csproj" />
  </ItemGroup>

</Project>
